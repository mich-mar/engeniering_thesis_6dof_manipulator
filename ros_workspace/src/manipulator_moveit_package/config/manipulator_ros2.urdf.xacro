<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="manipulator_ros2">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import manipulator_ros2 urdf file -->
    <xacro:include filename="$(find manipulator_ros2_description)/urdf/manipulator_ros2.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="manipulator_ros2.ros2_control.xacro" />


    <xacro:manipulator_ros2_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
