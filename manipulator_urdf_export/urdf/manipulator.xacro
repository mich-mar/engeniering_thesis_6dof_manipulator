  <child link="link_3_1"/>
  <axis xyz="-0.044167 -0.0 0.999024"/>
</joint>

<joint name="joint_3_to_4" type="continuous">
  <origin xyz="-0.020074 0.060964 -0.035689" rpy="0 0 0"/>
  <parent link="link_3_1"/>
  <child link="link_4_1"/>
  <axis xyz="0.999021 0.002653 0.044167"/>
</joint>

<joint name="joint_4_to_5" type="continuous">
  <origin xyz="-0.104122 -0.113297 0.051566" rpy="0 0 0"/>
  <parent link="link_4_1"/>
  <child link="link_5_1"/>
  <axis xyz="0.044191 -0.009603 -0.998977"/>
</joint>

<joint name="joint_5_to_eff" type="continuous">
  <origin xyz="0.011361 0.113751 -0.057067" rpy="0 0 0"/>
  <parent link="link_5_1"/>
  <child link="efector_1"/>
  <axis xyz="0.998995 -0.007126 0.04426"/>
</joint>

</robot>
