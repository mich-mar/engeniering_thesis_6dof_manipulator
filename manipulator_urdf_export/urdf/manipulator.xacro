<link name="link_5_1">
  <inertial>
    <origin xyz="0.035771108084248326 0.11289293638447143 -0.05402003742237102" rpy="0 0 0"/>
    <mass value="0.1597609646775879"/>
    <inertia ixx="5.6e-05" iyy="0.000103" izz="5.1e-05" ixy="-1e-06" iyz="-0.0" ixz="-5e-06"/>
  </inertial>
  <visual>
