    <origin xyz="0.07012 -0.305037 0.001482" rpy="0 0 0"/>
    <mass value="0.0"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.07012 -0.305037 0.001482" rpy="0 0 0"/>
