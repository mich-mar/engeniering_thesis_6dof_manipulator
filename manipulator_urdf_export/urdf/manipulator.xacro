<link name="efector_1">
  <inertial>
    <origin xyz="-0.031776908676389964 0.0007717709374218673 -0.002161999027492591" rpy="0 0 0"/>
    <mass value="0.3963549799563405"/>
    <inertia ixx="8e-05" iyy="0.000155" izz="0.00012" ixy="3e-06" iyz="-1e-06" ixz="4e-06"/>
  </inertial>
  <visual>
    <origin xyz="0.162881 -0.305491 0.006983" rpy="0 0 0"/>
