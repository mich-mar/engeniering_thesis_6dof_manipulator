<joint name="joint_base_to_1" type="continuous">
  <origin xyz="0.002447 0.063 0.001614" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="link_1_1"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="joint_1_to_2" type="continuous">
  <origin xyz="-0.000194 0.015512 0.002832" rpy="0 0 0"/>
  <parent link="link_1_1"/>
  <child link="link_2_1"/>
  <axis xyz="0.044167 0.0 -0.999024"/>
</joint>

<joint name="joint_2_to_3" type="continuous">
  <origin xyz="-0.052299 0.165561 0.029761" rpy="0 0 0"/>
