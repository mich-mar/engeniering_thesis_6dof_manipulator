<link name="link_3_1">
  <inertial>
    <origin xyz="0.050046 -0.244073 -0.034207" rpy="0 0 0"/>
    <mass value="0.0"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
